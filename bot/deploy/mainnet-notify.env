# BSC 主网 Telegram 提醒发送器配置（your-server：~/tapesurge-bot/run/mainnet-notify.env）。
# 令牌和口令在 secrets/reminder.env；RPC 用官方公共节点，省专属节点额度（每 3 分钟扫一次事件）。
# 主网发送器启动时，要先停掉测试网的发送器：两者共用同一份绑定名单，不停会给同一批用户发测试网的提醒。
CHAIN_ID=56
DEPLOYMENT_FILE=deployments/56.json
RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-rpc.publicnode.com
NOTIFY_API=https://app.tapesurge.com
APP_URL=https://app.tapesurge.com
NOTIFY_STATE_FILE=state/56.notify.json
NOTIFY_LOG_FILE=logs/56.notify.log
NOTIFY_INTERVAL_SEC=180
