# BSC 主网运营机器人配置（your-server：~/tapesurge-bot/run/mainnet.env）。不含任何密钥：
#   运营私钥在 secrets/mainnet.env（MAINNET_OPERATOR_PK，600 权限，用户自己生成），
#   RPC 在 secrets/rpc-mainnet.env（RPC_URLS，专属节点在前、官方公共节点在后），
#   报警在 secrets/telegram.env。三个文件都由 systemd 的 EnvironmentFile 读入。
# 主网部署完成后才有 deployments/56.json；在那之前这个服务不要启动（见 上线手册-BSC主网.md 第四节）。
CHAIN_ID=56
DEPLOYMENT_FILE=deployments/56.json
STATE_FILE=state/56.json
LOG_FILE=logs/56.log
OPERATOR_KEY_FILE=secrets/mainnet.env
OPERATOR_KEY_VAR=MAINNET_OPERATOR_PK
MARKET_SOURCE=firsto
MAX_GAS_GWEI=3
MIN_OPERATOR_BNB=0.02
MIN_VRF_BNB=0.02
# 经兑换的交易（矿机买卖、分账回购）走防夹子节点：PancakeSwap MEV Guard，备用 48 Club；60 秒没上链改发普通节点
SEND_RPC_URLS=https://bscrpc.pancakeswap.finance,https://rpc-bsc.48.club
# 24 小时内买一或卖一（按 BNB 日产能价）变动超过 15% 就暂停报价，直到项目方运行 node scripts/feed-confirm.mjs 56 确认（6.36）
FEED_MAX_DAY_CHANGE_BPS=1500
# 机器人买卖矿机时在 PancakeSwap 上换 BEM 的每小时上限（项目方 2026-10-26 决定：约全市场成交量的 10%，避免集中砸盘 / 拉盘）
BEM_HOURLY_CAP=80
