# TapeSurge 运营机器人配置。复制成 bot/.env 再填写；.env 不要提交、不要发给任何人。
#   cp .env.example .env && chmod 600 .env

# 链：56 = BNB Chain 主网，97 = BSC 测试网
CHAIN_ID=56

# RPC：逗号分隔多个，按顺序回退。主网建议至少一个付费节点（NodeReal / QuickNode / Ankr）
RPC_URLS=https://your-paid-rpc.example/KEY,https://bsc-rpc.publicnode.com

# 运营钱包私钥：放在单独的文件里（只有一行十六进制私钥），chmod 600。主网会检查权限。
# 这个钱包只做运营：开奖、推进、发放、挂单。不要放运营 gas 以外的资产。
OPERATOR_KEY_FILE=/home/tapesurge/operator.key
# 如果私钥文件是 KEY=VALUE 格式（例如测试网的 contracts/.env.testnet），写上变量名：
# OPERATOR_KEY_VAR=TESTNET_DEPLOYER_PK

# 部署地址文件（npm run sync 从 contracts/deployments 拷过来）
# DEPLOYMENT_FILE=deployments/56.json

# 每轮间隔（秒）。主网默认 60；测试网快速模式默认 15
# INTERVAL_SEC=60

# gas 价格上限（gwei）：超过就推迟，下一轮再试。BSC 平时约 0.05–0.1 gwei
MAX_GAS_GWEI=3

# 每笔 distribute 推送多少个插槽。月局每人约 8.1 万 gas，100 人约 810 万 gas
DISTRIBUTE_BATCH=100

# 月局结算时，交接不出去的矿机挂单价 = 成本价 × (1 + 溢价)。0 = 不主动挂单，1 天后合约自动按成本价挂单
LIST_PREMIUM_BPS=0

# 报警阈值
MIN_OPERATOR_BNB=0.02
MIN_VRF_BNB=0.02
# 等随机数超过多久报警（秒）
DRAW_ALERT_SEC=21600

# 报警通道（都可选；都不填时只写日志）
# Telegram：先找 @BotFather 建一个机器人拿 token，把它拉进群，再用 getUpdates 查 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 任意 webhook，收到 POST {"key","text"}
ALERT_WEBHOOK_URL=
# 心跳：每轮 GET 一次，机器人停了由对方通知你（例如 healthchecks.io 的免费检查）
HEARTBEAT_URL=
